{
  "name": "cad-tour",
  "private": true,
  "version": "0.1.0",
  "description": "CAD Tour: a Three.js apartment walkthrough with client-side DXF import",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build:test": "vite build --mode test --outDir dist-test",
    "preview:test": "vite preview --outDir dist-test --port 4174 --strictPort",
    "budget": "node scripts/check-budget.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "dxf-parser": "1.1.2",
    "n8ao": "2.0.1",
    "postprocessing": "6.39.5",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
